# ============================================================================
# AURA - AI Unified Review Assistant Environment Configuration Template
# Copy this file to .env for local development.
# DO NOT commit real credentials, endpoint URLs, tokens, or account IDs.
# ============================================================================

# Core Application Settings
AURA_ENV=development
AURA_DB_PATH=data/aura.db
AURA_LOG_LEVEL=INFO
AURA_LOG_FILE=logs/aura.log
AURA_MAX_TRANSCRIPT_LENGTH=12000
AURA_AGENT_MAX_TURNS=8
AURA_DEMO_MODE=true

# MCP Transport Configuration (stdio | streamable-http)
AURA_MCP_TRANSPORT=stdio
AURA_MCP_HOST=127.0.0.1
AURA_MCP_PORT=8080

# LLM Provider Selection (mock | kong | bedrock | azure_openai)
AURA_LLM_PROVIDER=mock
AURA_LLM_TIMEOUT_SECONDS=30

# Placeholder: Synchrony Kong AI Gateway
KONG_AI_GATEWAY_URL=https://placeholder-kong-gateway.example.internal/v1/chat/completions
KONG_API_KEY=PLACEHOLDER_KONG_API_KEY_DO_NOT_COMMIT
KONG_ROUTE_FAST=aura-fast-route-placeholder
KONG_ROUTE_DEEP=aura-deep-route-placeholder
KONG_ROUTE_CHALLENGER=aura-challenger-route-placeholder

# Placeholder: Amazon Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=PLACEHOLDER_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=PLACEHOLDER_AWS_SECRET_ACCESS_KEY
AWS_SESSION_TOKEN=PLACEHOLDER_AWS_SESSION_TOKEN
BEDROCK_FAST_MODEL_ID=placeholder.model-fast-v1:0
BEDROCK_DEEP_MODEL_ID=placeholder.model-deep-v1:0
BEDROCK_CHALLENGER_MODEL_ID=placeholder.model-challenger-v1:0

# Placeholder: Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://placeholder-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=PLACEHOLDER_AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_FAST_DEPLOYMENT=placeholder-fast-deployment
AZURE_OPENAI_DEEP_DEPLOYMENT=placeholder-deep-deployment
AZURE_OPENAI_CHALLENGER_DEPLOYMENT=placeholder-challenger-deployment
